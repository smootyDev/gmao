{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "db: docker compose up",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/start-db.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "backend: spring-boot:run",
            "type": "process",
            "command": "${workspaceFolder}/backend/mvnw.cmd",
            "args": [
                "spring-boot:run"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "dependsOn": [
                "db: docker compose up"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "frontend: ng serve",
            "type": "process",
            "command": "npm.cmd",
            "args": [
                "start"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "angular",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*(Building|Compiling|Generating browser application bundles).*",
                    "endsPattern": ".*(Application bundle generation complete|Local.*localhost.*4200).*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev",
                "clear": false
            }
        },
        {
            "label": "frontend: ng serve (solo terminal)",
            "type": "process",
            "command": "npm.cmd",
            "args": [
                "start"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        }
    ]
}
